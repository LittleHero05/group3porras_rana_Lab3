@model group3porras_rana_Lab3.ViewModels.EditCommentViewModel
@{ ViewData["Title"] = "Edit comment"; }
<h1>Edit your comment</h1>
<p class="text-muted">You can edit your own comments for 24 hours after posting.</p>
<form asp-controller="Comments" asp-action="Edit" method="post" class="col-lg-7">
    <input asp-for="ResourceId" type="hidden"/>
    <input asp-for="CommentId" type="hidden"/>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="CommentText" class="form-label"></label><textarea asp-for="CommentText" class="form-control" rows="5" maxlength="1000"></textarea><span asp-validation-for="CommentText" class="text-danger"></span></div>
    <button class="btn btn-primary" type="submit">Update comment</button>
    <a asp-controller="Resources" asp-action="Details" asp-route-id="@Model.ResourceId" class="btn btn-link">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
