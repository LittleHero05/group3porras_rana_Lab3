@model group3porras_rana_Lab3.ViewModels.ResourceDetailsViewModel
@{
    ViewData["Title"] = Model.Resource.Title;
    var resource = Model.Resource;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div><h1>@resource.Title</h1><p class="text-muted">@resource.Category.CategoryName · @resource.Author.FirstName @resource.Author.LastName</p></div>
    @if (User.IsInRole("Instructor"))
    {
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@resource.ResourceId" class="btn btn-outline-primary">Edit</a>
            <a asp-action="Delete" asp-route-id="@resource.ResourceId" class="btn btn-outline-danger">Delete</a>
        </div>
    }
</div>
<div class="card mb-4"><div class="card-body">
    <p>@resource.Description</p>
    <p class="small text-muted">Published @resource.CreatedDate.ToString("yyyy-MM-dd HH:mm") UTC · @resource.ViewCount views · @resource.FileName</p>
    <a asp-action="Download" asp-route-id="@resource.ResourceId" class="btn btn-primary">Open / download file</a>
</div></div>
<h2 class="h4">Comments (@Model.Comments.Count)</h2>
@if (Model.Comments.Count == 0) { <p class="text-muted">No comments yet.</p> }
@foreach (var comment in Model.Comments)
{
    <div class="card mb-2"><div class="card-body">
        <div class="d-flex justify-content-between gap-2">
            <strong>@comment.Username</strong>
            <span class="small text-muted">@comment.TimestampUtc.ToString("yyyy-MM-dd HH:mm") UTC</span>
        </div>
        <p class="mb-2" style="white-space:pre-wrap">@comment.CommentText</p>
        @if (comment.MayEdit(Model.CurrentUserId))
        {
            <a asp-controller="Comments" asp-action="Edit" asp-route-resourceId="@resource.ResourceId"
               asp-route-commentId="@comment.CommentId" class="btn btn-sm btn-outline-secondary">Edit comment</a>
        }
    </div></div>
}
<div class="card my-4"><div class="card-body">
    <h3 class="h5">Add a comment</h3>
    <form asp-controller="Comments" asp-action="Create" method="post">
        <input type="hidden" name="resourceId" value="@resource.ResourceId" />
        <textarea name="commentText" class="form-control mb-2" rows="3" maxlength="1000" required aria-label="Comment text"></textarea>
        <button class="btn btn-primary" type="submit">Post comment</button>
    </form>
</div></div>
<a asp-action="Index" class="btn btn-link">Back to resources</a>
