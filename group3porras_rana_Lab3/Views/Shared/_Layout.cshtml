<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Learning Portal</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/group3porras_rana_Lab3.styles.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Learning Portal</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#portalNav" aria-controls="portalNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div id="portalNav" class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Resources" asp-action="Index">Resources</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Resources" asp-action="Popular">Popular</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Resources" asp-action="Recent">Recent</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Resources" asp-action="Search">Search</a></li>
                        @if (User.IsInRole("Instructor")) { <li class="nav-item"><a class="nav-link" asp-controller="Resources" asp-action="Create">Add resource</a></li> }
                    }
                </ul>
                <ul class="navbar-nav align-items-lg-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><span class="nav-link">@User.Identity.Name (@(User.IsInRole("Instructor") ? "Instructor" : "Student"))</span></li>
                        <li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-secondary btn-sm" type="submit">Logout</button></form></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["Warning"] is string warning) { <div class="alert alert-warning">@warning</div> }
    <main role="main" class="pb-5">@RenderBody()</main>
</div>
<footer class="border-top text-muted py-3 mt-5"><div class="container">COMP306 Lab 3 · Group 3 · Learning Portal</div></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
